@startuml
left to right direction
actor Client

rectangle {

usecase "Login" as LOGIN
usecase "Extreure" as UC1
usecase "Ingressar" as UC2
usecase "Fer Transferencia" as UC3
usecase "Llistar Comptes" as UC4
usecase "Llistar moviments" as UC5

}

"Client" --> LOGIN
"Client" --> UC1
"Client" --> UC2
"Client" --> UC3
"Client" --> UC4
"Client" --> UC5

UC1 --> UC4 : <<include>>
UC2 --> UC4 : <<include>>
UC3 --> UC4 : <<include>>
UC5 --> UC4 : <<include>>
@enduml